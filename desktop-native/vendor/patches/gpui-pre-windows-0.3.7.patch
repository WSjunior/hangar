+    }
+    float2 uv = (position - backdrop_source.xy) / backdrop_source.zw;
+    // The entire sampled RGBA is premultiplied; do not multiply alpha again.
+    return t_sprite.SampleLevel(s_sprite, uv, 0.);
+}
