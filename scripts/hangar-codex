#!/usr/bin/env python3
"""Cria uma sessao Codex gerenciada pelo hangar e anexa o terminal ao tmux.

Funciona com o backend DESLIGADO, como `claude`, `pi` e `kimi` ja funcionavam. A fonte de verdade
da conversa e o SIDECAR em disco, que o lancador grava. Cada chamada cria uma sessao nova;
a API local acrescenta as limpezas de nome reusado quando esta disponivel.
"""
from __future__ import annotations

import json
import os
import shlex
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path


class BackendTransportError(RuntimeError):
    """O backend não pôde ser contactado; só esta falha permite o caminho local."""


class BackendHttpError(RuntimeError):
    def __init__(self, status: int, detail):
        self.status = status
        self.detail = detail
        super().__init__(f"HTTP {status}: {detail}")


def _repo() -> Path:
    return Path(__file__).resolve().parent.parent


def _do_backend():
    """Os dois modulos do backend que este wrapper usa, ou (None, None).

    Carregados por CAMINHO, e nao por `from app.adapters.codex import ...`: o import normal executa
    `app/adapters/__init__.py`, que instancia os quatro adapters e puxa `app.config` -> pydantic. Os
    dois modulos daqui sao stdlib puro de proposito (ver o cabecalho de lancador.py), mas isso nao
    adianta nada se o caminho ate eles nao for. Este wrapper roda no `python3` do sistema, sem o
    venv: numa maquina sem pydantic instalado no sistema, o import normal falharia e o wrapper
    voltaria a depender da API — que e exatamente o que ele nao pode fazer.

    Falhando mesmo assim, tudo aqui cai no plano B da API.
    """
    import importlib.machinery
    import importlib.util

    base = _repo() / "backend"
    sys.path.insert(0, str(base))   # `sessions.py` importa `app.atomico`/`app.names` (stdlib)

    def carregar(nome: str, caminho: Path):
        loader = importlib.machinery.SourceFileLoader(nome, str(caminho))
        spec = importlib.util.spec_from_loader(nome, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod

    codex = base / "app" / "adapters" / "codex"
    try:
        return (carregar("hangar_codex_sessions", codex / "sessions.py"),
                carregar("hangar_codex_lancador", codex / "lancador.py"))
    except (ImportError, OSError) as exc:
        print(f"hangar-codex: sem os modulos do backend ({exc}); usando a API", file=sys.stderr)
        return None, None


def _tmux_vivas() -> set[str]:
    r = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"],
                       capture_output=True, text=True)
    return {ln.strip() for ln in r.stdout.splitlines() if ln.strip()}


def _env() -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        for line in (_repo() / "backend" / ".env").read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                out[key.strip()] = value.strip()
    except OSError:
        pass
    return out


def _api(method: str, path: str, body: dict | None = None):
    env = _env()
    token = os.environ.get("CP_AUTH_TOKEN") or env.get("CP_AUTH_TOKEN")
    port = os.environ.get("CP_PORT") or env.get("CP_PORT") or "8765"
    if not token:
        raise BackendTransportError(
            f"hangar-codex: CP_AUTH_TOKEN ausente em {_repo() / 'backend' / '.env'}")
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}",
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        try:
            detail = json.loads(detail)
        except (TypeError, ValueError):
            pass
        if isinstance(detail, dict) and isinstance(detail.get("detail"), dict):
            detail = detail["detail"]
        raise BackendHttpError(exc.code, detail) from exc
    except (OSError, TimeoutError, urllib.error.URLError) as exc:
        raise BackendTransportError(f"backend inacessivel em 127.0.0.1:{port}: {exc}") from exc


def _base_name(cwd: str) -> str:
    clean = "".join(c if c.isalnum() or c in "_-" else "-" for c in Path(cwd).name)
    return clean.strip("-") or "codex"


def _nomes_livres(cwd: str, ocupados: set[str]):
    base = _base_name(cwd)
    for index in range(1, 1000):
        name = base if index == 1 else f"{base}-{index}"
        if name not in ocupados:
            yield name


def _local_codex_account() -> str:
    home = os.environ.get("CODEX_HOME")
    if not home or Path(home).expanduser().resolve(strict=False) == (Path.home() / ".codex").resolve(strict=False):
        return "default"
    return "custom"


def _create(cwd: str, prompt: str | None) -> str:
    existing = {item["name"] for item in _api("GET", "/api/sessions")}
    codex_account = None
    inherited_home = os.environ.get("CODEX_HOME")
    if inherited_home and _local_codex_account() == "custom":
        home = Path(inherited_home).expanduser().resolve(strict=False)
        contas = _api("GET", "/api/codex-contas")
        for conta in contas:
            try:
                if Path(conta["home"]).expanduser().resolve(strict=False) == home:
                    codex_account = conta["id"]
                    break
            except (KeyError, TypeError, ValueError):
                continue
        if codex_account is None:
            raise RuntimeError(
                "CODEX_HOME personalizado não é uma conta Codex gerenciada neste servidor"
            )
    for name in _nomes_livres(cwd, existing):
        try:
            body = {
                "name": name,
                "cwd": cwd,
                "provider": "codex",
                "initial_prompt": prompt,
            }
            if codex_account is not None:
                body["codex_account"] = codex_account
            result = _api("POST", "/api/sessions", body)
            return result["name"]
        except BackendHttpError as exc:
            detail = exc.detail if isinstance(exc.detail, dict) else {}
            code = detail.get("code")
            if exc.status == 409 and code == "erro_nome_em_uso":
                continue
            raise
    raise RuntimeError("nao foi possivel escolher um nome de sessao livre")


def _create_local(cwd: str, prompt: str | None, lancador) -> str:
    """Cria a sessao direto no tmux, sem backend. O comando do pane e o MESMO que o backend usa.

    O que se perde sem a API sao as limpezas de nome reusado (fila duravel, vinculo 'then',
    pareamento) e o escopo transiente do systemd. Nenhuma delas impede a sessao de funcionar, e
    todas voltam a valer na proxima criacao com o backend no ar — enquanto nao abrir nada e o
    defeito que este ticket existe pra corrigir.

    NAO pre-confia o cwd (o `codex_sessions.pretrust_cwd` que o backend chama na criacao pelo app),
    e isso e deliberado: aqui tem uma pessoa na frente do terminal, e a pergunta "voce confia nesta
    pasta?" e dela. Pelo app ninguem tem como responder, e por isso la a resposta e dada; aqui,
    responder por ela seria decidir confianca no lugar de quem digitou o comando — o `claude` e o
    `pi` do shell tambem nao pre-confiam nada.
    """
    ocupados = _tmux_vivas()
    name = next(_nomes_livres(cwd, ocupados))
    codex_home = os.environ.get("CODEX_HOME") or str((Path.home() / ".codex").resolve(strict=False))
    cmd = shlex.join(lancador.comando_do_lancador(
        cwd, prompt, codex_home=codex_home,
        codex_account=_local_codex_account()))
    r = subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", cwd,
                        "-e", f"CP_SESSION_NAME={name}", cmd],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"tmux recusou criar a sessao {name}: {r.stderr.strip()}")
    return name


def _limpar_local(name: str, codex_sessions) -> None:
    """Limpeza que o backend faria no DELETE: mata o app-server por pid e apaga o sidecar.

    Normalmente o proprio lancador ja fez isto ao ver a TUI sair. Isto cobre o pane derrubado sem
    que ele chegasse la — e, sem backend, era o caso em que sobrava sidecar orfao mais um servidor
    escutando em loopback, calado.
    """
    if codex_sessions is None:
        print(f"hangar-codex: sem API e sem os modulos do backend — o sidecar de {name} pode ter "
              "ficado para tras", file=sys.stderr)
        return
    meta = codex_sessions.load(name) or {}
    pid = meta.get("app_pid")
    if isinstance(pid, int):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass          # ja morreu (o caso comum: o lancador chegou primeiro)
    codex_sessions.delete(name)


def main() -> int:
    if len(sys.argv) > 2:
        print("uso: hangar-codex [prompt]", file=sys.stderr)
        return 2
    prompt = sys.argv[1] if len(sys.argv) == 2 else None
    cwd = os.getcwd()
    codex_sessions, lancador = _do_backend()
    try:
        try:
            name = _create(cwd, prompt)
        except BackendTransportError as exc:
            if lancador is None:
                raise
            print(f"hangar-codex: backend fora ({exc}); criando direto no tmux",
                  file=sys.stderr)
            name = _create_local(cwd, prompt, lancador)
    except RuntimeError as exc:
        print(f"hangar-codex: {exc}", file=sys.stderr)
        return 1
    print(f"Codex gerenciado pelo hangar: {name} (detach: Ctrl-b d)", file=sys.stderr)
    # Um terminal novo pode herdar o ambiente de um pane que ja morreu.
    pane = os.environ.get("TMUX_PANE")
    in_tmux = bool(os.environ.get("TMUX") and pane) and subprocess.run(
        ["tmux", "list-panes", "-t", pane],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0
    if not in_tmux:
        os.environ.pop("TMUX", None)
        os.environ.pop("TMUX_PANE", None)
    if in_tmux:
        attached = subprocess.run(["tmux", "switch-client", "-t", f"={name}"]).returncode
        if attached == 0:
            # O helper continua no pane antigo enquanto o cliente usa a sessao Codex. Quando ela
            # termina, o tmux volta para outra sessao e este processo conclui a limpeza.
            while subprocess.run(
                ["tmux", "has-session", "-t", f"={name}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode == 0:
                time.sleep(0.5)
    else:
        attached = subprocess.run(["tmux", "attach-session", "-t", f"={name}"]).returncode
    # Se o usuario encerrou o Codex, remove o sidecar/app-server. Se apenas deu detach, a sessao
    # continua viva no tmux e no app.
    alive = subprocess.run(
        ["tmux", "has-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0
    if not alive:
        try:
            _api("DELETE", f"/api/sessions/{name}")
        except RuntimeError:
            _limpar_local(name, codex_sessions)
    return attached


if __name__ == "__main__":
    raise SystemExit(main())
